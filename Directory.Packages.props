      Include="Microsoft.Extensions.Configuration"
      Version="11.0.0-preview.4.26230.115"
    />
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection"
      Version="11.0.0-preview.4.26230.115"
    />
